APP_MODE=desktop
HOST=127.0.0.1
PORT=8001

DATABASE_URL=sqlite:///data/photo_inventory.db
STORAGE_MODE=copy
PHOTO_STORAGE_ROOT=storage/photos
THUMBNAIL_ROOT=storage/thumbnails
IMPORT_FOLDER=photos

TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

EXTRACTOR_NAME=photo_intelligence
EXTRACTOR_VERSION=local-dev

# Optional semantic backend (Ollama + Qdrant). Keep this file secret-free.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:14b
EMBEDDING_MODEL=nomic-embed-text
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=photo_intelligence_docs
DATA_SOURCES_PATH=data_sources
APP_DB_PATH=data/photo_inventory.db
TOP_K=8
MAX_CONTEXT_CHARS=14000
ANSWER_TEMPERATURE=0.1
STORE_CHAT_LOGS=false
